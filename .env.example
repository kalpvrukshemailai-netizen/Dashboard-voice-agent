# HSK Builder Group AI Calling Platform - Environment Variables (Version 1 - Production Hardened)

# Google Sheets + Google Apps Script Web App (System of Record)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Server-to-Server Authentication Secret between Next.js and Google Apps Script
# MUST match 'HSK_SHARED_SECRET' configured in Google Apps Script ScriptProperties
HSK_APPS_SCRIPT_SHARED_SECRET=your_secure_shared_secret_min_32_chars

# ElevenLabs Conversational AI Voice Agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=xi_api_key_xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_AGENT_PHONE_NUMBER_ID=phnum_xxxxxxxxxxxxxxxxxxxx

# ElevenLabs Webhook Authentication Secret (for HMAC SHA-256 signature verification)
ELEVENLABS_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Scheduler / Queue Worker Protection Secret (Required to authorize /api/scheduler/worker)
# MUST match 'CRON_SECRET' configured in Google Apps Script ScriptProperties
CRON_SECRET=your_secure_cron_token_here

# Operator Admin Secret (Required for /api/system/state lock release and manual reconciliation)
ADMIN_SECRET=your_secure_admin_token_here

# Technical Failure Retry Policy (Safe defaults: automatic retries disabled until explicitly enabled)
ENABLE_AUTO_TECHNICAL_RETRIES=false
MAX_TECHNICAL_RETRIES=0

# Development & Test Mode Flag (Set to true to use in-memory test double without live Google account)
# HSK_USE_TEST_DOUBLE=true
