# HSK Builder Group AI Calling Platform - Environment Variables (Version 1)

# Google Sheets + Google Apps Script Web App (System of Record)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# ElevenLabs Conversational AI Voice Agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=xi_api_key_xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_AGENT_PHONE_NUMBER_ID=phnum_xxxxxxxxxxxxxxxxxxxx

# ElevenLabs Webhook Authentication Secret (for HMAC SHA-256 signature verification)
ELEVENLABS_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Scheduler / Queue Worker Protection Secret (Optional for securing /api/scheduler/worker)
CRON_SECRET=your_secure_cron_token_here

# Development & Test Mode Flag (Set to true to use in-memory test double without live Google account)
# HSK_USE_TEST_DOUBLE=true
